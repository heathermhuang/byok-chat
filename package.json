{
  "name": "byok-chat",
  "version": "0.1.0",
  "description": "Browser-local BYOK chat workspace with a hardened Cloudflare Worker proxy.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "build:official": "tsc --noEmit && vite build --mode official",
    "check": "npm test && npm run build",
    "deploy": "npm run deploy:staging",
    "deploy:self-hosted": "npm run verify:public-env && npm run build && wrangler deploy --config wrangler.local.toml --keep-vars",
    "deploy:staging": "npm run verify:official-env && npm run build:official && wrangler deploy --config wrangler.staging.toml --keep-vars",
    "deploy:production": "npm run verify:official-env && npm run build:official && wrangler deploy --keep-vars",
    "dev": "npm run build && wrangler dev --local --port ${PORT:-8799}",
    "release:assets": "node scripts/compare-deploy-assets.mjs",
    "start": "npm run dev",
    "test": "node --import tsx --test test/*.test.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "verify:official-env": "node --env-file=.env.official scripts/check-public-env.mjs",
    "verify:public-env": "node scripts/check-public-env.mjs"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heathermhuang/byok-chat.git"
  },
  "homepage": "https://byok.chat",
  "bugs": {
    "url": "https://github.com/heathermhuang/byok-chat/issues"
  },
  "keywords": [
    "byok",
    "chat",
    "cloudflare-workers",
    "openai-compatible",
    "react"
  ],
  "dependencies": {
    "@assistant-ui/react": "^0.15.11",
    "lucide-react": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "unpdf": "^1.8.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "wrangler": "^4.114.0"
  }
}
