# Optional override for staging or a different GA4 property.
# Production byok.chat defaults to G-GJRR7KP2G1; non-production hosts stay
# analytics-free unless this override is supplied at build time.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Required public production identity and monitored privacy contact. Use the
# exact legal person/entity operating the service, not the product name.
VITE_OPERATOR_NAME=Your legal operator name
VITE_LEGAL_CONTACT_EMAIL=privacy@example.com
